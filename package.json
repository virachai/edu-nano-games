{
  "name": "edu-nano-games",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Lean, enterprise-grade educational mini-games (TypeScript/TS-emitted vanilla JS/HTML5, zero runtime dependencies for the games).",
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "@remotion/player": "4.0.525",
    "remotion": "4.0.525"
  }
}
